# AssemblyAI is required for transcription
ASSEMBLYAI_API_KEY=your-assemblyai-key

# OpenRouter powers DeepSeek responses (chapters, explanations)
# Provide one key (OPENROUTER_API_KEY) or a comma-separated list (OPENROUTER_API_KEYS)
OPENROUTER_API_KEY=
# OPENROUTER_API_KEYS=sk-or-v1-aaaaaaaa,sk-or-v1-bbbbbbbb

# Optional: customize the fallback model list (comma separated)
# OPENROUTER_MODEL_LIST=deepseek/deepseek-chat-v3-0324:free,deepseek/deepseek-chat-v3.1:free

# Optional: override primary model and endpoint (used by /api/explain)
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Optional tuning (used by /api/explain; defaults shown)
# OPENROUTER_MAX_TOKENS_SUMMARY=600
# OPENROUTER_TEMPERATURE=0.7
# OPENROUTER_TOP_P=0.9
# OPENROUTER_TIMEOUT_MS=60000

# Optional metadata sent to OpenRouter (helps ranking dashboard)
# OPENROUTER_SITE_URL=http://localhost:3000/
# OPENROUTER_APP_NAME=Lecture Transcript Studio
